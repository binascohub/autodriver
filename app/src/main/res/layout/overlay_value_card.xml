<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/tw_input_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/accent_amber"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="240dp"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TwCardTitle"
                android:text="Valor/Km" />

            <TextView
                android:id="@+id/overlay_close_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/tw_icon_button_bg"
                android:fontFamily="@font/barlow_medium"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/tw_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_reject_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/plex_mono_semibold"
            android:letterSpacing="0.1"
            android:text="Destino na lista de recusar"
            android:textAllCaps="true"
            android:textColor="@color/tw_red_400"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlay_value_per_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plex_mono_bold"
                android:textColor="@color/accent_amber"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/plex_mono_medium"
                android:letterSpacing="0.06"
                android:text="R$/KM"
                android:textColor="@color/tw_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                android:tint="@color/tw_text_secondary" />

            <TextView
                android:id="@+id/overlay_destination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_regular"
                android:textColor="@color/tw_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
