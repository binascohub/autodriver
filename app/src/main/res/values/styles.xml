<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TwCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/tw_surface</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/tw_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Dashboard label-plate treatment: mono, uppercase, wide tracking —
         reads like an engraved panel label rather than a generic section
         heading. -->
    <style name="TwCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:textColor">@color/tw_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Tabular numeric readout — used for every number the driver has to
         read at a glance (thresholds, history values, captured coordinates),
         so figures always line up like a meter's digit wheels. -->
    <style name="TwMonoValue">
        <item name="android:fontFamily">@font/plex_mono_semibold</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>

    <style name="OverlayTheme" parent="Theme.MaterialComponents.NoActionBar" />

    <style name="TwPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/tw_button_bg</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textColor">@color/ink_on_amber</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
