<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tw_bg">#0F172A</color>
    <color name="tw_blue_600">#407EB8</color>
    <color name="tw_border">#334155</color>
    <color name="tw_green_400">#4ADE80</color>
    <color name="tw_green_600">#16A34A</color>
    <color name="tw_header_bg">#0B1220</color>
    <color name="tw_input_bg">#0F172A</color>
    <color name="tw_red_400">#F87171</color>
    <color name="tw_red_600">#DC2626</color>
    <color name="tw_surface">#1E293B</color>
    <color name="tw_text_primary">#F8FAFC</color>
    <color name="tw_text_secondary">#94A3B8</color>
    <color name="tw_white">#FFFFFF</color>
    <string name="accessibility_service_description">Lê o valor e a distância das ofertas de corrida do Uber para mostrar o card flutuante com o valor por km.</string>
    <string name="app_name">Autodriver</string>
    <string name="google_web_client_id">REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com</string>
    <string name="local_text"/>
    <style name="OverlayTheme" parent="Theme.MaterialComponents.NoActionBar"/>
    <style name="TwCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/tw_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/tw_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TwCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tw_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TwPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/tw_button_bg</item>
        <item name="android:textColor">@color/tw_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>